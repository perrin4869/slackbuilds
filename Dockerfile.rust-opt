FROM slackbuilds:15.0

# rust-opt has REQUIRES="" (it's just a prebuilt-binary repack) - plain
# single-package install, no queue/dependency handling needed. Baked in
# so check.yml doesn't rebuild this toolchain on every run for the
# packages that need it (jujutsu, difftastic).
RUN sbopkg -B -e stop -i rust-opt
